{
  "name": "electron-react-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal Electron desktop starter with React, TypeScript, and Vite.",
  "license": "MIT",
  "author": "Maximilian Stümpfl",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxstue/vite-reactts-electron-starter.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev --watch",
    "start": "install-electron && electron-vite preview --skipBuild",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json",
    "lint": "eslint .",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  }
}
